# ============================================================
# TeamBot Environment Variables
# ============================================================
# Copy this file to .env (для локального запуска) или
# .env.docker (для docker compose --env-file .env.docker).
#
# ВАЖНО:
#   * Если значение содержит символ '$' (пароли, секреты) — оборачивайте
#     его в ОДИНАРНЫЕ кавычки, иначе Docker Compose попытается подставить
#     переменную:  PASSWORD='p@ss$word'
#   * Списки и словари можно задавать как JSON:
#         ADMIN_IDS=[1,2,3]
#     или как CSV (для list[int] и list[str]):
#         ADMIN_IDS=1,2,3
#     Пустая строка '' или [] трактуется как пустой список.

# ============================================================
# ОСНОВНАЯ БД (PostgreSQL)
# ============================================================
DB_MAIN_NAME=team_bot
DB_MAIN_USER=user
DB_MAIN_PASSWORD=password
DB_MAIN_HOST=localhost
DB_MAIN_PORT=5432
DB_MAIN_POOL_SIZE=10
DB_MAIN_MAX_OVERFLOW=20
DB_MAIN_ECHO=false

# ============================================================
# БД AVANPOST (MSSQL)
# ============================================================
DB_AVANPOST_NAME=avanpost
DB_AVANPOST_USER=avanpost_user
DB_AVANPOST_PASSWORD=avanpost_password
DB_AVANPOST_HOST=localhost
DB_AVANPOST_PORT=1433
DB_AVANPOST_DRIVER=ODBC Driver 18 for SQL Server
DB_AVANPOST_POOL_SIZE=5
DB_AVANPOST_MAX_OVERFLOW=10
DB_AVANPOST_ECHO=false

# ============================================================
# AVANPOST SYNC
# ============================================================
AVANPOST_AUTO_ADD_USERS_ALL_ON_START=true
AVANPOST_AUTO_ADD_USERS_IDS_ON_START=[]
AVANPOST_AUTO_SYNC_ON_START=true
AVANPOST_AUTO_ADD_VEHICLES_ON_START=false

AVANPOST_SYNC_FORCE=false
AVANPOST_SYNC_ASYNC=true
AVANPOST_SYNC_USERS_BASE=true
AVANPOST_SYNC_USERS_DETAILS=true
AVANPOST_SYNC_USERS_DETAILS_IDS=[]
AVANPOST_SYNC_USER_IDS=[]
AVANPOST_SYNC_REQUIRED=false
AVANPOST_SYNC_TIMEOUT=300
AVANPOST_SYNC_CHUNK_SIZE=10

# ============================================================
# TELEGRAM
# ============================================================
BOT_TOKEN=your_bot_token_here
BOT_ID=your_api_id_here
BOT_HASH=your_api_hash_here
BOT_SESSION_NAME=bot_session
BOT_USERNAME=your_bot_username
TELEGRAM_ACCOUNT_TYPE=bot

# Для user-аккаунта (если TELEGRAM_ACCOUNT_TYPE="user")
USER_PHONE=
USER_SESSION_NAME=user_session

# ============================================================
# TEAMDROID (gRPC / HTTP upload)
# ============================================================
TEAMDROID_HOST=localhost:16060
TEAMDROID_HTTP_UPLOAD_URL=http://localhost:6060/v0/file/u
TEAMDROID_API_KEY=apikey
TEAMDROID_USERNAME=root
TEAMDROID_PASSWORD=password
TEAMDROID_APP_ID=0
TEAMDROID_GRPC_MAX_MESSAGE=16777216
TEAMDROID_CTRL_TIMEOUT=10

# ============================================================
# SQL SERVER (Teamdroid / Avanpost procedures)
# ============================================================
# ОДНО singleton-соединение используется для всех процедур:
#   ext.PA_mbl_AuthStart_Exec
#   ext.PA_mbl_AuthFinish_Exec
#   ext.PA_mbl_TokenVerify_Exec
#   ext.PA_mbl_TokenFinish_Exec
#   ext.PA_mbl_TokenDevices_Load
#   ext.PA_mbl_MsgsDeliveryStatus_Edit
#   ext.PA_mbl_AppUpdateCheck_Exec
TEAMDROID_SQL_SERVER=
TEAMDROID_SQL_DATABASE=
TEAMDROID_SQL_USERNAME=
# '$' в пароле → одинарные кавычки: TEAMDROID_SQL_PASSWORD='p@ss$word'
TEAMDROID_SQL_PASSWORD=
TEAMDROID_SQL_TIMEOUT=10

# Имена процедур (менять не нужно, если на SQL Server те же имена)
TEAMDROID_SQL_PROC_AUTH_START=ext.PA_mbl_AuthStart_Exec
TEAMDROID_SQL_PROC_AUTH_LOGIN=ext.PA_mbl_AuthLogin_Exec
TEAMDROID_SQL_PROC_TOKEN_VERIFY=ext.PA_mbl_TokenVerify_Exec
TEAMDROID_SQL_PROC_TOKEN_FINISH=ext.PA_mbl_TokenFinish_Exec
TEAMDROID_SQL_PROC_TOKEN_DEVICES_LOAD=ext.PA_mbl_TokenDevices_Load
TEAMDROID_SQL_PROC_EDIT_MSG_STATUS_DELIVERY=ext.PA_mbl_MsgsDeliveryStatus_Edit
TEAMDROID_SQL_PROC_APP_UPDATE_CHECK=ext.PA_mbl_AppUpdateCheck_Exec
TEAMDROID_SQL_PROC_APP_UPDATE_OFFERED=ext.PA_mbl_AppUpdateOffered_Exec
TEAMDROID_SQL_PROC_APP_UPDATE_CHECK_ALL=ext.PA_mbl_AppUpdateCheckAll_Exec
TEAMDROID_SQL_PROC_SYNC_BASE_LOAD=ext.PA_mbl_SyncBaseData_Load
TEAMDROID_SQL_PROC_SYNC_BASE_EDIT=ext.PA_mbl_SyncBaseData_Edit
TEAMDROID_SQL_PROC_NOTIFIES_LOAD=ext.PA_mbl_Notifies_Load
TEAMDROID_SQL_PROC_NOTIFIES_SEND=ext.PA_mbl_Notifies_Send

# ============ FILES / UPLOADS / MESSAGES (chunked upload) ============
TEAMDROID_SQL_PROC_FILES_LOAD=ext.PA_mbl_Files_Load
TEAMDROID_SQL_PROC_MSG_SEND=ext.PA_mbl_MsgOut_Exec

# Files / uploads (не-процедурные)
UPLOAD_CHUNK_SIZE=1048576
UPLOAD_MIN_CHUNK_SIZE=65536
UPLOAD_MAX_FILE_SIZE=104857600
UPLOAD_ALLOWED_EXTENSIONS=["pdf","doc","docx","xls","xlsx","jpg","jpeg","png"]
UPLOAD_RETENTION_DAYS=7
UPLOAD_STORAGE_BACKEND=local
UPLOAD_LOCAL_DIR=./data/uploads
UPLOAD_URL_PREFIX=/api/v1/client/files
UPLOAD_CLEANUP_INTERVAL_SEC=300

# ============================================================
# PUSH / WS / FCM
# ============================================================
WS_NOTIFY_ENABLED=True
WS_NOTIFY_PATH=/ws/notify

# Режим проверки токена:
#   trust     — принять user_id как есть (только development)
#   grpc      — проверка через Tinode gRPC (legacy)
#   avanpost  — проверка через Teamdroid SQL Server (основной режим)
WS_NOTIFY_TOKEN_VERIFY_MODE=avanpost
WS_NOTIFY_TOKEN_CACHE_TTL=300

WS_NOTIFY_MAX_CONNECTIONS_PER_USER=10
WS_NOTIFY_HEARTBEAT_INTERVAL=30
WS_NOTIFY_SEND_TIMEOUT=5.0

# Bearer-токен, который Go-адаптер myrelay передаёт в POST /internal/push.
# Должен совпадать с auth_token в tinode.conf (push -> myrelay -> auth_token).
WS_RELAY_AUTH_TOKEN=change_me
WS_RELAY_INGEST_PATH=/internal/push

# Base64-ключ AES-256-GCM (32 байта) для расшифровки WS-токена.
# Должен совпадать с BuildConfig.WS_TOKEN_KEY в Android-клиенте.
WS_TOKEN_KEY_B64=

# -------------------- FCM --------------------
# FCM работает только при ОДНОВРЕМЕННОМ выполнении:
#   1. FCM_ENABLED=true
#   2. FCM_SEND_MODE != "never"
#   3. FCM_CREDENTIALS_PATH указывает на СУЩЕСТВУЮЩИЙ service account JSON
FCM_ENABLED=True
FCM_LOAD_FIDS_ON_START=True
FCM_CREDENTIALS_PATH=/app/config/firebase-service-account.json

# Режим отправки FCM:
#   always   — всегда (WS + FCM одновременно)
#   fallback — только если WS не доставил; для "sub" — всегда
#   never    — только WS
FCM_SEND_MODE=fallback
FCM_FID_TTL_SECONDS=604800

# ============================================================
# MOBILE APPS (ingest keys)
# ============================================================
# Три НЕЗАВИСИМЫХ набора ключей (settings.API_KEY_HEADER). Пустой набор = 503.
# Каждый набор можно задать JSON-массивом или CSV.
#
# APP_SERVER_SYNC_INGEST_API_KEYS:
#   POST /api/v1/teamdroid/* (send-files, send-text, delete-messages,
#   grant-user, user-id, acs, health)
#
# APP_CLIENT_SYNC_INGEST_API_KEYS:
#   POST   /api/v1/client/register
#   DELETE /api/v1/client/register
#   POST   /api/v1/client/send-code
#   POST   /api/v1/client/login
#   POST   /api/v1/client/note
#   GET    /api/v1/client/health
#
# APP_CLIENT_SUPPORT_INGEST_API_KEYS:
#   POST /api/v1/logs/batch
#   POST /api/v1/logs/request/{id}/decline
APP_SERVER_SYNC_INGEST_API_KEYS=["change_me_server_sync_key_1"]
APP_CLIENT_SYNC_INGEST_API_KEYS=["change_me_client_sync_key_1"]
APP_CLIENT_SUPPORT_INGEST_API_KEYS=["change_me_client_support_key_1"]

# ---- Sync session registry (in-memory, per-user) ----
APP_CLIENT_SYNC_BASE_DEFAULT_LIMIT=1000
APP_CLIENT_SYNC_BASE_MAX_LIMIT=50_000
APP_CLIENT_SYNC_BASE_LOAD_TIMEOUT_SEC=30
APP_CLIENT_SYNC_BASE_EDIT_TIMEOUT_SEC=20
# TTL записей реестра выданных sync-пакетов (сек). 60..86400.
APP_CLIENT_SYNC_BASE_REGISTRY_TTL_SEC=3600
# Максимум Load-ов на пользователя без Edit (защита от HasMore-цикла). 1..10000.
APP_CLIENT_SYNC_BASE_REGISTRY_MAX_ITERATIONS=100
# Таймаут незавершившихся итераций sync-load (сек). Считается от
# ПОСЛЕДНЕГО sync-load, а не от первого. Если клиент не сделал
# успешный sync-edit за это время — счётчик итераций сбрасывается
# фоновым cleanup-ом, и sync-load снова доступен (даже если клиент
# застрял в 429 too_many_iterations).
APP_CLIENT_SYNC_BASE_REGISTRY_ITERATIONS_STALE_SEC=300
# Максимум пакетов (разных ts) на пользователя в реестре. 1..1000.
APP_CLIENT_SYNC_BASE_REGISTRY_MAX_PACKETS_PER_USER=10
# Требовать подтверждения ТОЛЬКО последнего выданного sync-пакета.
# false (по умолчанию) — клиент может подтверждать пачку пакетов одним Edit.
# true — Edit со старым ts отвергается (защита от рассинхрона часов).
APP_CLIENT_SYNC_BASE_REGISTRY_REQUIRE_LATEST=false

# Жёсткий лимит размера одной RecordData (байт). При превышении sync-load
# вернёт 413. Клиент должен уменьшить lmt или (если серверная процедура
# поддержит HasMore для одного типа) — разбить тип.
APP_CLIENT_SYNC_BASE_MAX_RECORD_BYTES=10485760

# Максимум items в одном POST /client/sync-edit.
APP_CLIENT_SYNC_BASE_MAX_EDIT_ITEMS=100

# Максимум Firebase Installation ID (устройств) на одного пользователя.
APP_CLIENT_MAX_FIDS_PER_USER=10

APP_CLIENT_FILE_LINK_SECRET=secret

APP_CLIENT_ERROR_DEVICE_NOT_REGISTERED=no_dev

APP_CLIENT_SUPPORT_LOGS_INGEST_ENABLED=true
APP_CLIENT_SUPPORT_LOGS_MAX_BATCH_BYTES=1048576
APP_CLIENT_SUPPORT_LOGS_MAX_BATCH_UNCOMPRESSED_BYTES=4194304
APP_CLIENT_SUPPORT_LOGS_MAX_RECORDS_PER_BATCH=5000
APP_CLIENT_SUPPORT_LOGS_MAX_MSG_LEN=4096
APP_CLIENT_SUPPORT_LOGS_MAX_TRACE_LEN=16384
APP_CLIENT_SUPPORT_LOGS_MAX_FIELDS_LEN=4096
APP_CLIENT_SUPPORT_LOGS_REQUESTS_PER_DAY=3
APP_CLIENT_SUPPORT_LOGS_FORCE_ALL_PER_DAY=1
APP_CLIENT_SUPPORT_LOGS_BYTES_PER_DAY=1048576
APP_CLIENT_SUPPORT_LOGS_REQUEST_TTL_SEC=3600
APP_CLIENT_SUPPORT_LOGS_REQUEST_FORCE_ALL_MAX_BYTES=524288
APP_CLIENT_SUPPORT_LOGS_RETENTION_INFO_DAYS=30
APP_CLIENT_SUPPORT_LOGS_RETENTION_ERROR_DAYS=90
APP_CLIENT_SUPPORT_LOGS_REQUESTS_RETENTION_DAYS=30
APP_CLIENT_SUPPORT_LOGS_PUSH_TYPE=logs_request

APP_UPDATE_APK_DIR=/app/update/apk
APP_UPDATE_PUBLIC_DIR=/app/update/public
APP_UPDATE_PUBLIC_URL=https://avanpost.aps-solver.com
APP_UPDATE_POLLING_ENABLED=True
APP_UPDATE_CHECK_INTERVAL_SEC=300
APP_UPDATE_NOTIFY_COOLDOWN_SEC=43200

# ============================================================
# API
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
# Основной набор API-ключей (admin / бизнес-API).
API_KEYS=["change_me_api_key"]
API_KEY_HEADER=[change_me_api_header]
APP_ENV=production
APP_DEBUG=false
API_RELOAD=false
API_WORKERS=1
API_TRUSTED_HOSTS=["127.0.0.1","::1","172.16.0.0/12","192.168.12.1"]

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5

# ============================================================
# НАСТРОЙКИ БОТА
# ============================================================
ADMIN_IDS=[1039799368]
SYNC_INTERVAL=300
MAX_MESSAGE_LENGTH=4096

# ============================================================
# TELETHON
# ============================================================
TELEGRAM_API_RETRY=3
TELEGRAM_RECONNECT_DELAY=5
TELEGRAM_CATCH_UP_ON_START=true
TELEGRAM_SYNC_CHATS_ON_START=true

# ============================================================
# RATE LIMITING
# ============================================================
API_RATE_LIMIT=100
API_RATE_PERIOD=60
BOT_RATE_LIMIT=10
BOT_COMMAND_LIMIT=5
BOT_RATE_PERIOD=60
BOT_COMMAND_PERIOD=10

# ============================================================
# ENCRYPTION
# ============================================================
ENCRYPTION_SECRET=your_encryption_secret_here

# ============================================================
# NOTIFICATIONS / ERRORS
# ============================================================
DEFAULT_NOTIFICATION_LEVEL=error
DEFAULT_GROUPING_WINDOW=60
DEFAULT_AUTO_REPORT_INTERVAL=60
DEFAULT_WORK_HOURS_START=9
DEFAULT_WORK_HOURS_END=18

ERROR_GROUPING_ENABLED=true
ERROR_GROUPING_WINDOW_MINUTES=60
ERROR_MAX_OCCURRENCES_BEFORE_SILENCE=10

# ============================================================
# REMINDERS
# ============================================================
REMINDER_MAX_PER_USER=100
REMINDER_DEFAULT_INTERVAL=0
REMINDER_MAX_REMIND_COUNT=10
REMINDER_CHECK_INTERVAL=60
REMINDER_BATCH_SIZE=100

# ============================================================
# SUPPORT / LOG ERRORS
# ============================================================
SUPPORT_CHAT_ID=0
SUPPORT_CHAT_TOPIC_IDS={}
LOG_ERROR_NOTIFICATION_INTERVAL=60
LOG_ERROR_AUTO_CAPTURE=true
LOG_ERROR_MAX_MESSAGE_LENGTH=500
LOG_ERROR_MAX_TRACEBACK_LENGTH=1000
LOG_ERROR_GROUPING_ENABLED=true
LOG_ERROR_CLEAR_CACHE_ON_START=true
LOG_ERROR_MESSAGE_LIFETIME_SECONDS=604800

# ============================================================
# AUTOMATION
# ============================================================
AUTOMATION_CONVERSION_METHOD=auto
AUTOMATION_MAX_FILE_SIZE=52428800
AUTOMATION_TEMP_DIR=./temp/automation
AUTOMATION_RETRY_COUNT=3
AUTOMATION_RETRY_DELAY=2
AUTOMATION_CLEANUP_AFTER=3600
AUTOMATION_ALLOWED_EXTENSIONS=[".doc",".docx"]
AUTOMATION_MAX_REQUESTS_PER_USER=50
AUTOMATION_REQUIRE_ADMIN_APPROVAL=true
AUTOMATION_NOTIFICATION_CHAT_IDS=[]
AUTOMATION_AUTO_CLEANUP=true
AUTOMATION_CONVERSION_TIMEOUT=60
AUTOMATION_STATS_ENABLED=true
AUTOMATION_STATS_MAX_ENTRIES=1000

# ============================================================
# MESSAGE LIFETIME / MISC
# ============================================================
MESSAGE_LIFETIME_CHECK_INTERVAL=60
MESSAGE_LIFETIME_BATCH_SIZE=1000
MESSAGE_LIFETIME_DEFAULT_SECONDS=300
SYNC_CACHE_TTL_SECONDS=60
ERROR_GROUP_CACHE_TTL_SECONDS=300
LOG_QUEUE_MAX_SIZE=1000
LOG_WORKER_TIMEOUT=0.3
BOT_MESSAGE_LIFETIME_SECONDS=300
KEYBOARD_BUTTONS_PER_ROW=3
AUTH_CACHE_TTL_SECONDS=3600
HTTP_TIMEOUT_KEEP_ALIVE=30
TELEGRAM_POLLING_TIMEOUT=30
TELEGRAM_RETRY_DELAY=5
TELEGRAM_MAX_RETRIES=5
API_DEFAULT_PAGE_SIZE=50
API_STATS_DAYS=7

# ============================================================
# MIGRATIONS / ENTRYPOINT
# ============================================================
ALEMBIC_CONFIG=/app/alembic.ini
SKIP_MIGRATIONS=false
MIGRATIONS_REQUIRED=true
MIGRATION_RETRIES=3
DB_WAIT_ATTEMPTS=30
RUN_SEED=false
CHECK_MIGRATIONS=false

# ============================================================
# APP MODE (docker compose command: --mode ${APP_MODE})
# ============================================================
APP_MODE=full
