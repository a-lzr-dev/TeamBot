# ============================================================
# TeamBot Environment Variables
# ============================================================

# Copy this file to .env and adjust for your needs

# -------------------- PostgreSQL --------------------
DB_MAIN_NAME=team_bot
DB_MAIN_USER=user
DB_MAIN_PASSWORD=password
DB_MAIN_HOST=localhost
DB_MAIN_PORT=5432
DB_MAIN_URL="postgresql+asyncpg://${DB_MAIN_USER}:${DB_MAIN_PASSWORD}@${DB_MAIN_HOST}:${DB_MAIN_PORT}/${DB_MAIN_NAME}"

# -------------------- MSSQL (Avanpost) --------------------
DB_AVANPOST_NAME=avanpost
DB_AVANPOST_USER=avanpost_user
DB_AVANPOST_PASSWORD=avanpost_password
DB_AVANPOST_HOST=localhost
DB_AVANPOST_PORT=1433
DB_AVANPOST_URL="mssql+aioodbc://${DB_AVANPOST_USER}:${DB_AVANPOST_PASSWORD}@${DB_AVANPOST_HOST}:${DB_AVANPOST_PORT}/${DB_AVANPOST_NAME}?driver=ODBC+Driver+17+for+SQL+Server"

# -------------------- SQL Server (Teamdroid / Avanpost procedures) --------------------
# ОДНО соединение используется для всех четырёх процедур:
#   ext.PA_mbl_AuthStart_Exec
#   ext.PA_mbl_AuthFinish_Exec
#   ext.PA_mbl_TokenVerify_Exec
#   ext.PA_mbl_TokenFinish_Exec
#   ext.PA_mbl_MsgsDeliveryStatus_Edit
TEAMDROID_SQL_SERVER=
TEAMDROID_SQL_DATABASE=
TEAMDROID_SQL_USERNAME=
TEAMDROID_SQL_PASSWORD=
TEAMDROID_SQL_TIMEOUT=10

# Процедуры на сервере
TEAMDROID_SQL_PROC_AUTH_START=ext.PA_mbl_AuthStart_Exec
TEAMDROID_SQL_PROC_AUTH_FINISH=ext.PA_mbl_AuthFinish_Exec

# Хранимая процедура Avanpost для проверки WS-токена.
# Контракт:
#   EXEC ext.PA_mbl_TokenVerify_Exec @Params = N'<json>'
# JSON: {"usi":"<хэш>","api":<int>,"dvc":"<fcm>","tkn":"yyMMdd","cip":"<ip>","ver":"...","vcd":"..."}
# Выход: (Success BIT). При отсутствии пользователя — THROW 50000
# ('PRC_avp_VerifyToken_NoData'), обрабатывается Python-сервером как отказ.
TEAMDROID_SQL_PROC_TOKEN_VERIFY=ext.PA_mbl_TokenVerify_Exec

# Хранимая процедура Avanpost для заверщения WS-токена.
# Контракт:
#   EXEC ext.PA_mbl_TokenFinish_Exec @Params = N'<json>'
# JSON: {"usi":"<хэш>","api":<int>,"dvc":"<fcm>"}
# Выход: (Success BIT). При отсутствии пользователя — THROW 50000
# ('PRC_avp_VerifyFinish_NoData'), обрабатывается Python-сервером как отказ.
TEAMDROID_SQL_PROC_TOKEN_FINISH=ext.PA_mbl_TokenFinish_Exec

# Хранимая процедура Avanpost для сохранения факта доставки/прочтения
# сообщения (вызывается после успешной отправки {note} в Tinode).
# Контракт: EXEC ext.PA_mbl_MsgsDeliveryStatus_Edit @Params = N'<json>'
# JSON: {"topic": "<topic>", "what": "recv"|"read", "seq": <int>,
#         "user_id": "usrXXX", "client_ip": "<ip>"}
TEAMDROID_SQL_PROC_EDIT_MSG_STATUS_DELIVERY=ext.PA_mbl_MsgsDeliveryStatus_Edit

# -------------------- Avanpost Sync --------------------
# Автоматическая действия при старте приложения
AVANPOST_AUTO_ADD_USERS_ALL_ON_START=true
AVANPOST_AUTO_ADD_USERS_IDS_ON_START=[]
AVANPOST_AUTO_SYNC_ON_START=true

# Принудительная полная синхронизация (игнорировать кеш)
AVANPOST_SYNC_FORCE=false

# Режим синхронизации
AVANPOST_SYNC_ASYNC=true

# Синхронизация пользовательских данных (Общие данные)
AVANPOST_SYNC_USERS_BASE=true

# Синхронизация пользовательских данных (Персональные данные)
AVANPOST_SYNC_USERS_DETAILS=true

# Ручной список синхронизации пользовательских данных (Персональные данные)
AVANPOST_SYNC_USERS_DETAILS_IDS=[]

# Требовать успешную синхронизацию для старта приложения
AVANPOST_SYNC_REQUIRED=false

# Таймаут синхронизации в секундах (0 - без ограничения)
AVANPOST_SYNC_TIMEOUT=300

# Размер чанка для синхронизации (количество типов данных за один запрос)
AVANPOST_SYNC_CHUNK_SIZE=10

# -------------------- Telegram --------------------
BOT_TOKEN=your_bot_token_here
BOT_ID=your_api_id_here
BOT_HASH=your_api_hash_here
BOT_SESSION_NAME=bot_session
BOT_USERNAME=your_bot_username
TELEGRAM_ACCOUNT_TYPE=bot

# Для user-аккаунта (если TELEGRAM_ACCOUNT_TYPE = "user")
USER_PHONE=+000000000000
USER_SESSION_NAME=user_session

# -------------------- WS Notify --------------------
WS_NOTIFY_ENABLED=True
WS_NOTIFY_PATH=/ws/notify

# Режим проверки токена: "trust" | "grpc" | "avanpost"
#   trust — принять user_id как есть (только development)
#   grpc — проверка через Tinode gRPC (legacy)
#   avanpost — проверка через MSSQL Avanpost (основной режим)
WS_NOTIFY_TOKEN_VERIFY_MODE=avanpost
WS_NOTIFY_TOKEN_CACHE_TTL=300

WS_NOTIFY_MAX_CONNECTIONS_PER_USER=10
WS_NOTIFY_HEARTBEAT_INTERVAL=30
WS_NOTIFY_SEND_TIMEOUT=5.0

# Bearer token expected by POST /internal/push. Must equal `auth_token`
# configured in the Go adapter (tinode.conf, section "push" -> myrelay).
WS_RELAY_AUTH_TOKEN=change_me
WS_RELAY_INGEST_PATH=/internal/push

# Base64-ключ AES-256-GCM (32 байта) для расшифровки WS-токена
WS_TOKEN_KEY_B64=

# AppID приложения Teamdroid (dir.TRSDirSysApps.FID).
# Используется в двух процедурах:
#   1) ext.PA_mbl_TokenVerify_Exec — как $.api (проверка WS-токена).
#   2) ext.PA_mbl_TokenFinish_Exec — как $.api (проверка WS-токена).
#   3) ext.PA_mbl_MsgsDeliveryStatus_Edit — как $.api (сохранение
#      факта доставки/прочтения; процедура делает
#      JOIN dir.TRSDirSysApps da ON da.FID = jsn.AppID).
# Обязателен для WS-verify в режиме "avanpost" (иначе процедура
# бросает THROW) и для сохранения recv/read (иначе NoData).
TEAMDROID_APP_ID=0

# FCM (Firebase Cloud Messaging) — для доставки, когда WS-клиента нет онлайн.
FCM_ENABLED=True
# CHANGED: явно указано, что путь ведёт к JSON-ключу service account Firebase.
# Раньше в коде читалось FIREBASE_CREDENTIALS_PATH (не совпадало с этим именем),
# из-за чего FCM не инициализировался в production.
FCM_CREDENTIALS_PATH=/app/config/firebase-service-account.json

# Режим отправки FCM:
#   "always"   — всегда (WS + FCM одновременно) — соответствует ТЗ п.5
#                (помимо WS-оповещения отправляется FCM FID).
#   "fallback" — только если WS не доставил (для обычных сообщений),
#                для "sub" (приглашений в чат) — всегда.
#   "never"    — только WS, FCM не отправляется.
FCM_SEND_MODE=fallback

# TTL записи FID -> user_id (на случай, если WS вообще не было, а FCM пришёл), # 7 дней
FCM_FID_TTL_SECONDS=604800

# -------------------- API --------------------
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=production
APP_DEBUG=false

# -------------------- Logging --------------------
LOG_LEVEL=INFO
LOG_DIR=./logs

# -------------------- Admin --------------------
ADMIN_IDS=[1039799368]

# -------------------- Encryption --------------------
ENCRYPTION_SECRET=your_encryption_secret_here

# -------------------- Support --------------------
SUPPORT_CHAT_ID=0
SUPPORT_CHAT_TOPIC_IDS={}

# -------------------- Database Pool --------------------
DB_MAIN_POOL_SIZE=10
DB_MAIN_MAX_OVERFLOW=20
DB_MAIN_ECHO=false

DB_AVANPOST_POOL_SIZE=5
DB_AVANPOST_MAX_OVERFLOW=10
DB_AVANPOST_ECHO=false

# -------------------- Rate Limiting --------------------
API_RATE_LIMIT=100
API_RATE_PERIOD=60
BOT_RATE_LIMIT=10
BOT_COMMAND_LIMIT=5
BOT_RATE_PERIOD=60
BOT_COMMAND_PERIOD=10

# -------------------- Message Lifetime --------------------
MESSAGE_LIFETIME_CHECK_INTERVAL=60
MESSAGE_LIFETIME_BATCH_SIZE=1000
MESSAGE_LIFETIME_DEFAULT_SECONDS=300

# -------------------- Reminders --------------------
REMINDER_CHECK_INTERVAL=60
REMINDER_BATCH_SIZE=100
REMINDER_MAX_PER_USER=100
REMINDER_DEFAULT_INTERVAL=0
REMINDER_MAX_REMIND_COUNT=10

# -------------------- Automation --------------------
AUTOMATION_CONVERSION_METHOD=auto
AUTOMATION_MAX_FILE_SIZE=52428800
AUTOMATION_TEMP_DIR=./temp/automation
AUTOMATION_RETRY_COUNT=3
AUTOMATION_RETRY_DELAY=2
AUTOMATION_CLEANUP_AFTER=3600
AUTOMATION_ALLOWED_EXTENSIONS=[".doc",".docx"]
AUTOMATION_MAX_REQUESTS_PER_USER=50
AUTOMATION_REQUIRE_ADMIN_APPROVAL=true
AUTOMATION_NOTIFICATION_CHAT_IDS=[]
AUTOMATION_AUTO_CLEANUP=true
AUTOMATION_CONVERSION_TIMEOUT=60
AUTOMATION_STATS_ENABLED=true
AUTOMATION_STATS_MAX_ENTRIES=1000

# -------------------- Error Handling --------------------
ERROR_GROUPING_ENABLED=true
ERROR_GROUPING_WINDOW_MINUTES=60
ERROR_MAX_OCCURRENCES_BEFORE_SILENCE=10
ERROR_GROUP_CACHE_TTL_SECONDS=300

# -------------------- Log Error Notifications --------------------
LOG_ERROR_NOTIFICATION_INTERVAL=60
LOG_ERROR_AUTO_CAPTURE=true
LOG_ERROR_MAX_MESSAGE_LENGTH=500
LOG_ERROR_MAX_TRACEBACK_LENGTH=1000
LOG_ERROR_GROUPING_ENABLED=true
LOG_ERROR_CLEAR_CACHE_ON_START=true
LOG_ERROR_MESSAGE_LIFETIME_SECONDS=604800
LOG_QUEUE_MAX_SIZE=1000
LOG_WORKER_TIMEOUT=0.3

# -------------------- Telegram Clients --------------------
TELEGRAM_API_RETRY=3
TELEGRAM_RECONNECT_DELAY=5
TELEGRAM_CATCH_UP_ON_START=true
TELEGRAM_SYNC_CHATS_ON_START=true
TELEGRAM_POLLING_TIMEOUT=30
TELEGRAM_RETRY_DELAY=5
TELEGRAM_MAX_RETRIES=5
SYNC_CACHE_TTL_SECONDS=60

# -------------------- Keyboard --------------------
KEYBOARD_BUTTONS_PER_ROW=3

# -------------------- Auth --------------------
AUTH_CACHE_TTL_SECONDS=3600

# -------------------- HTTP --------------------
HTTP_TIMEOUT_KEEP_ALIVE=30

# -------------------- API Defaults --------------------
API_DEFAULT_PAGE_SIZE=50
API_STATS_DAYS=7

# -------------------- Notifications --------------------
DEFAULT_NOTIFICATION_LEVEL=error
DEFAULT_GROUPING_WINDOW=60
DEFAULT_AUTO_REPORT_INTERVAL=60
DEFAULT_WORK_HOURS_START=9
DEFAULT_WORK_HOURS_END=18

# -------------------- Bot Messages --------------------
BOT_MESSAGE_LIFETIME_SECONDS=300
